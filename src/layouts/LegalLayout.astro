---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";

// Markdown pages (`src/pages/privacy.md`, `src/pages/terms.md`) pass their frontmatter here.
interface Props {
  frontmatter: {
    title: string;
    description: string;
    updated: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={`Prowl — ${frontmatter.title}`} description={frontmatter.description}>
  <Nav active="none" />

  <main class="legal-page">
    <header class="legal-header">
      <h1 class="legal-title">{frontmatter.title}</h1>
      <p class="legal-updated">Last updated {frontmatter.updated}</p>
    </header>

    <article class="legal-content">
      <slot />
    </article>

    <footer class="legal-footer">
      <a href="/privacy/">Privacy</a>
      <span aria-hidden="true">·</span>
      <a href="/terms/">Terms</a>
      <span aria-hidden="true">·</span>
      <a href="/">Home</a>
    </footer>
  </main>
</Layout>

<style>
  .legal-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 8rem 1.5rem 4rem;
  }

  .legal-header {
    margin-bottom: 2.5rem;
  }

  .legal-title {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .legal-updated {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .legal-content :global(h2) {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: 2.75rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .legal-content :global(h3) {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .legal-content :global(p) {
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 0.9rem;
  }

  .legal-content :global(ul) {
    list-style: none;
    padding: 0;
    margin-bottom: 1rem;
  }

  .legal-content :global(li) {
    position: relative;
    padding-left: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 0.45rem;
  }

  .legal-content :global(li::before) {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  .legal-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .legal-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(90, 228, 192, 0.08);
    color: var(--accent-dim);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .legal-content :global(a) {
    text-decoration: underline;
    text-decoration-color: rgba(90, 228, 192, 0.35);
    text-underline-offset: 2px;
  }

  .legal-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0.5rem 0 1.25rem;
    font-size: 0.9rem;
  }

  .legal-content :global(th),
  .legal-content :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .legal-content :global(th) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .legal-footer {
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-soft);
    display: flex;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .legal-footer a {
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .legal-page {
      padding-top: 6.5rem;
    }

    .legal-title {
      font-size: 1.6rem;
    }

    .legal-content :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>
