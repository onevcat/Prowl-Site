---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";

const features = [
  { name: "Canvas", blurb: "Every agent live on one board. Broadcast to all of them.", href: "/details/#layout" },
  { name: "Shelf", blurb: "Worktrees as book spines. Flip through them from the keyboard.", href: "/details/#layout" },
  { name: "Agent Island", blurb: "Who is working, blocked, or done, from any app.", href: "/details/#agents" },
  { name: "Workflows", blurb: "Multi-agent runs Prowl executes and supervises.", href: "/details/#automate" },
  { name: "prowl CLI", blurb: "Let agents read, drive, and coordinate panes.", href: "/details/#cli" },
];
---

<Layout title="Prowl — Quiet paws. Sharp claws.">
  <Nav active="home" />

  <main class="hero">
    <div class="hero-layout">
      <div class="hero-text">
        <h1 class="title">Prowl</h1>
        <p class="slogan">Quiet paws.<br />Sharp claws.</p>
        <p class="subtitle">
          A native macOS command center for running AI coding agents in parallel.
        </p>

        <div class="cta-group">
          <a
            href="https://github.com/onevcat/Prowl/releases/latest/download/Prowl.dmg"
            class="btn btn-primary"
            target="_blank"
            rel="noopener"
          >
            <svg class="btn-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M8 2v8m0 0l-3-3m3 3l3-3M3 12v1.5h10V12" />
            </svg>
            Download
          </a>
          <a href="/details/" class="btn btn-secondary">
            Details
            <svg class="btn-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 3l5 5-5 5" />
            </svg>
          </a>
        </div>
        <p class="brew-note">
          Or install through Homebrew:
          <br />
          <span class="brew-command" id="brew-command">brew install --cask onevcat/tap/prowl</span>
          <button type="button" class="brew-copy" id="brew-copy" aria-label="Copy Homebrew install command">Copy</button>
        </p>

        <p class="fork-note">
          Free &amp; open source · macOS 26+ · A personal fork of
          <a href="https://supacode.sh/" target="_blank" rel="noopener">Supacode</a>, built for daily use.
        </p>
      </div>

      <div class="hero-visual">
        <div class="visual-stage">
          <a class="icon-wrap" href="/details/" aria-label="See what Prowl does">
            <img src="/images/prowl-icon.png" alt="" class="app-icon" width="220" height="220" />
          </a>
          <ul class="feature-index">
            {features.map((f) => (
              <li>
                <a href={f.href} class="feature-row">
                  <span class="feature-name">{f.name}</span>
                  <span class="feature-blurb">{f.blurb}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <button
          type="button"
          class="video-trigger"
          id="video-trigger"
          aria-label="Watch the Prowl demo video"
          aria-haspopup="dialog"
          aria-controls="video-modal"
        >
          <span class="video-trigger-icon" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="currentColor" width="9" height="9">
              <polygon points="2.5,1.5 10.5,6 2.5,10.5" />
            </svg>
          </span>
          <span class="video-trigger-label">Watch demo</span>
        </button>
      </div>

      <!-- Paw prints between title and visual -->
      <div class="paw-bridge">
        {["p1", "p2", "p3"].map((cls) => (
          <svg class:list={["paw", cls]} data-paw viewBox="0 0 20 20" fill="currentColor" role="button" tabindex="0" aria-label="Toggle bright paw">
            <ellipse cx="6.5" cy="3.5" rx="2" ry="2.4" />
            <ellipse cx="13.5" cy="3.5" rx="2" ry="2.4" />
            <ellipse cx="3.2" cy="8.8" rx="1.7" ry="2.1" />
            <ellipse cx="16.8" cy="8.8" rx="1.7" ry="2.1" />
            <path d="M10 18.5c-3.2 0-5.8-2.2-5.8-4.5 0-2 1.6-3.5 3.2-3.5.9 0 1.4.6 2.6.6s1.7-.6 2.6-.6c1.6 0 3.2 1.5 3.2 3.5 0 2.3-2.6 4.5-5.8 4.5z" />
          </svg>
        ))}
      </div>
    </div>

    <footer class="footer">
      <p>
        Built by <a href="https://github.com/onevcat" target="_blank" rel="noopener">@onevcat</a>
        with <span class="heart">&hearts;</span>
      </p>
    </footer>
  </main>

  <div class="video-modal" id="video-modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Prowl demo video">
    <div class="video-modal-backdrop" data-close></div>
    <div class="video-modal-content">
      <button type="button" class="video-modal-close" id="video-modal-close" aria-label="Close video">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" width="16" height="16" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" />
        </svg>
      </button>
      <div class="video-modal-frame" id="video-modal-frame"></div>
    </div>
  </div>
</Layout>

<script>
  const brewCopyButton = document.getElementById("brew-copy") as HTMLButtonElement | null;
  const brewCommand = document.getElementById("brew-command")?.textContent?.trim();
  brewCopyButton?.addEventListener("click", async () => {
    if (!brewCommand || !brewCopyButton) return;
    try {
      await navigator.clipboard.writeText(brewCommand);
      brewCopyButton.textContent = "Copied";
      brewCopyButton.classList.add("copied");
    } catch {
      brewCopyButton.textContent = "Copy failed";
    }
    window.setTimeout(() => {
      brewCopyButton.textContent = "Copy";
      brewCopyButton.classList.remove("copied");
    }, 1200);
  });

  // Paw prints: light up in sequence; light all three yourself before the
  // sequence finishes and the demo button turns into a certain cat.
  const pawPrints = document.querySelectorAll<HTMLElement>(".paw[data-paw]");
  const videoTrigger = document.getElementById("video-trigger");
  let autoPawComplete = false;
  let easterTriggered = false;
  pawPrints.forEach((paw) => paw.setAttribute("aria-pressed", "false"));

  function maybeTriggerEaster() {
    if (autoPawComplete || easterTriggered) return;
    if (!Array.from(pawPrints).every((p) => p.classList.contains("lit"))) return;
    easterTriggered = true;
    videoTrigger?.classList.add("rainbow");
  }

  function togglePaw(paw: HTMLElement) {
    const isLit = paw.classList.toggle("lit");
    paw.setAttribute("aria-pressed", String(isLit));
    maybeTriggerEaster();
  }

  document.addEventListener("click", (event) => {
    for (const paw of pawPrints) {
      const rect = paw.getBoundingClientRect();
      if (event.clientX >= rect.left && event.clientX <= rect.right && event.clientY >= rect.top && event.clientY <= rect.bottom) {
        togglePaw(paw);
        break;
      }
    }
  });
  pawPrints.forEach((paw) => {
    paw.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        togglePaw(paw);
      }
    });
  });

  (function startAutoPawSequence() {
    const sequence = Array.from(pawPrints).reverse();
    let idx = 0;
    function step() {
      if (idx >= sequence.length) {
        autoPawComplete = true;
        if (!easterTriggered) videoTrigger?.classList.add("pulse");
        return;
      }
      const paw = sequence[idx++];
      if (!easterTriggered && !paw.classList.contains("lit")) {
        paw.classList.add("lit");
        paw.setAttribute("aria-pressed", "true");
      }
      window.setTimeout(step, 600);
    }
    window.setTimeout(step, 2600);
  })();

  // Demo video modal
  const videoModal = document.getElementById("video-modal");
  const videoModalFrame = document.getElementById("video-modal-frame");
  const videoModalClose = document.getElementById("video-modal-close");
  const VIDEO_EMBED_SRC = "https://www.youtube-nocookie.com/embed/4GYlXPttwi0?autoplay=1&rel=0&modestbranding=1";

  function openVideoModal() {
    if (!videoModal || !videoModalFrame) return;
    // The iframe is injected at runtime and carries no Astro scope hash.
    const IFRAME_STYLE = "position:absolute;inset:0;width:100%;height:100%;border:0;display:block";
    videoModalFrame.innerHTML =
      '<iframe src="' + VIDEO_EMBED_SRC + '" title="Prowl demo" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" allowfullscreen style="' + IFRAME_STYLE + '"></iframe>';
    videoModal.hidden = false;
    videoModal.setAttribute("aria-hidden", "false");
    requestAnimationFrame(() => videoModal.classList.add("open"));
    document.body.style.overflow = "hidden";
    videoModalClose?.focus();
  }

  function closeVideoModal() {
    if (!videoModal || !videoModalFrame) return;
    videoModal.classList.remove("open");
    videoModal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    window.setTimeout(() => {
      if (!videoModal.classList.contains("open")) {
        videoModalFrame.innerHTML = "";
        videoModal.hidden = true;
      }
    }, 240);
    videoTrigger?.focus();
  }

  videoTrigger?.addEventListener("click", openVideoModal);
  videoModalClose?.addEventListener("click", closeVideoModal);
  videoModal?.querySelector("[data-close]")?.addEventListener("click", closeVideoModal);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && videoModal && !videoModal.hidden) closeVideoModal();
  });
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 60% at 72% 45%, rgba(90, 228, 192, 0.05) 0%, transparent 60%),
      var(--bg-primary);
  }

  .hero-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 2.5rem;
    align-items: center;
    max-width: 1120px;
    width: 100%;
    padding: 6rem 3rem 4rem;
  }

  /* ── Text ── */
  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .title {
    font-family: var(--font-mono);
    font-size: 4.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .slogan {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.02em;
    line-height: 1.4;
    margin-bottom: 1.25rem;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 380px;
    line-height: 1.7;
    margin-bottom: 2.25rem;
    text-wrap: pretty;
  }

  .cta-group {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-mono);
    border: 1px solid transparent;
    border-radius: 6px;
    transition: transform 0.15s, box-shadow 0.15s, background 0.15s, border-color 0.15s, color 0.15s;
    cursor: pointer;
  }

  .btn-icon {
    width: 15px;
    height: 15px;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--bg-primary);
    border-color: var(--accent);
  }

  .btn-primary:hover {
    opacity: 1;
    background: #6ef0cc;
    border-color: #6ef0cc;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(90, 228, 192, 0.28);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-secondary);
    border-color: rgba(136, 153, 180, 0.25);
  }

  .btn-secondary:hover {
    opacity: 1;
    color: var(--text-primary);
    border-color: rgba(136, 153, 180, 0.5);
    transform: translateY(-1px);
  }

  .brew-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0.3rem 0 1.5rem;
    line-height: 1.6;
  }

  .brew-command {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    background: rgba(90, 228, 192, 0.08);
    border-radius: 4px;
    padding: 0.08rem 0.35rem;
    margin-left: 0.2rem;
  }

  .brew-copy {
    margin-left: 0.45rem;
    padding: 0.08rem 0.35rem;
    border-radius: 4px;
    border: 1px solid rgba(136, 153, 180, 0.28);
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.65rem;
    font-family: var(--font-mono);
    cursor: pointer;
  }

  .brew-copy:hover {
    border-color: rgba(136, 153, 180, 0.45);
  }

  .brew-copy.copied {
    color: var(--accent);
    border-color: rgba(90, 228, 192, 0.45);
    background: rgba(90, 228, 192, 0.12);
  }

  .fork-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    max-width: 380px;
  }

  .fork-note a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: rgba(136, 153, 180, 0.3);
    text-underline-offset: 2px;
  }

  .fork-note a:hover {
    color: var(--accent);
    opacity: 1;
  }

  /* ── Visual: icon + feature index ── */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 2.25rem;
    width: 100%;
  }

  .icon-wrap {
    position: relative;
    display: block;
    width: 200px;
    height: 200px;
    border-radius: 44px;
    opacity: 1;
  }

  .icon-wrap::before {
    content: "";
    position: absolute;
    inset: -40px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(90, 228, 192, 0.16), transparent 68%);
    filter: blur(10px);
    pointer-events: none;
  }

  .app-icon {
    position: relative;
    width: 200px;
    height: 200px;
    border-radius: 44px;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(90, 228, 192, 0.12);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .icon-wrap:hover .app-icon {
    transform: rotate(-3deg) scale(1.03);
  }

  .feature-index {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .feature-index li {
    opacity: 0;
    transform: translateX(10px);
    animation: row-in 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .feature-index li:nth-child(1) { animation-delay: 0.15s; }
  .feature-index li:nth-child(2) { animation-delay: 0.27s; }
  .feature-index li:nth-child(3) { animation-delay: 0.39s; }
  .feature-index li:nth-child(4) { animation-delay: 0.51s; }
  .feature-index li:nth-child(5) { animation-delay: 0.63s; }

  @keyframes row-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .feature-row {
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.55rem 0.75rem;
    margin-left: -0.75rem;
    border-radius: 8px;
    color: var(--text-secondary);
    transition: background 0.15s, color 0.15s;
  }

  .feature-row:hover {
    opacity: 1;
    background: rgba(90, 228, 192, 0.06);
    color: var(--text-primary);
  }

  .feature-name {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .feature-row:hover .feature-name {
    color: var(--accent);
  }

  .feature-blurb {
    font-size: 0.85rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* ── Watch demo trigger ── */
  .video-trigger {
    position: absolute;
    left: 42px;
    bottom: -3.6rem;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem 0.5rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--bg-primary);
    background: var(--accent);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    box-shadow:
      0 10px 28px rgba(90, 228, 192, 0.35),
      0 0 0 4px var(--bg-primary);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .video-trigger::after {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 999px;
    border: 2px solid var(--accent);
    opacity: 0;
    z-index: -1;
    pointer-events: none;
  }

  .video-trigger.pulse::after {
    animation: trigger-pulse 2.4s ease-out infinite;
  }

  @keyframes trigger-pulse {
    0% { transform: scale(0.95); opacity: 0.55; }
    80% { transform: scale(1.35); opacity: 0; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  .video-trigger:hover {
    transform: translateY(-1px) scale(1.04);
    box-shadow:
      0 12px 32px rgba(90, 228, 192, 0.45),
      0 0 0 4px var(--bg-primary);
  }

  .video-trigger-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(11, 18, 33, 0.92);
    color: var(--accent);
  }

  .video-trigger-label {
    line-height: 1;
  }

  /* Easter egg: all three paws lit before the sequence finishes. */
  .video-trigger.rainbow {
    padding: 0;
    width: 110px;
    height: 64px;
    color: transparent;
    font-size: 0;
    background-color: transparent;
    background-image: url("https://media.tenor.com/8lR3_1m-i94AAAAi/cat.gif");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 12px;
    box-shadow: none;
    filter: drop-shadow(0 8px 18px rgba(90, 228, 192, 0.35));
  }

  .video-trigger.rainbow .video-trigger-icon,
  .video-trigger.rainbow .video-trigger-label,
  .video-trigger.rainbow::after {
    display: none;
  }

  .video-trigger.rainbow:hover {
    transform: scale(1.06);
    box-shadow: none;
  }

  /* ── Paw prints ── */
  .paw-bridge {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .paw {
    position: absolute;
    color: rgba(90, 228, 192, 0.22);
    opacity: 0;
    animation: paw-appear 0.8s ease-out forwards;
    cursor: pointer;
    pointer-events: auto;
    transition: color 0.25s ease, filter 0.25s ease;
    outline: none;
  }

  .p1 { width: 30px; bottom: 30%; left: 34%; transform: rotate(-80deg); animation-delay: 2s; }
  .p2 { width: 26px; bottom: 26%; left: 37.5%; transform: rotate(-72deg); animation-delay: 1.6s; }
  .p3 { width: 22px; bottom: 30%; left: 41%; transform: rotate(-64deg); animation-delay: 1.2s; }

  .paw.lit {
    color: rgba(142, 255, 219, 0.98);
    filter: drop-shadow(0 0 12px rgba(90, 228, 192, 0.65));
  }

  .paw:focus-visible {
    outline: 1px solid rgba(90, 228, 192, 0.55);
    outline-offset: 3px;
  }

  @keyframes paw-appear {
    to { opacity: 1; }
  }

  /* ── Video modal ── */
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
  }

  .video-modal[hidden] {
    display: none;
  }

  .video-modal.open {
    opacity: 1;
    pointer-events: auto;
  }

  .video-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 10, 20, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .video-modal-content {
    position: relative;
    width: 100%;
    max-width: 1440px;
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - 6rem);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-deep);
    box-shadow:
      0 32px 100px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.04);
    transform: scale(0.96);
    transition: transform 0.22s ease;
  }

  .video-modal.open .video-modal-content {
    transform: scale(1);
  }

  .video-modal-frame {
    position: absolute;
    inset: 0;
  }

  .video-modal-close {
    position: absolute;
    top: -44px;
    right: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, transform 0.15s;
  }

  .video-modal-close:hover {
    background: rgba(255, 255, 255, 0.14);
    transform: scale(1.06);
  }

  /* ── Footer ── */
  .footer {
    position: absolute;
    bottom: 1rem;
    left: 0;
    right: 0;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.75rem;
    z-index: 1;
  }

  .footer a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: rgba(136, 153, 180, 0.3);
    text-underline-offset: 2px;
  }

  .footer a:hover {
    color: var(--accent);
    opacity: 1;
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .hero {
      flex-direction: column;
    }

    .hero-visual {
      flex-direction: column;
    }

    .hero-layout {
      grid-template-columns: 1fr;
      gap: 3.5rem;
      padding: 7rem 2rem 5rem;
      text-align: center;
    }

    .hero-text {
