<script>
  // ── Chapters: tabs ⇄ horizontal scroll-snap track ──
  document.querySelectorAll<HTMLElement>("[data-chapter]").forEach((chapter) => {
    const track = chapter.querySelector<HTMLElement>("[data-track]");
    const tabs = Array.from(chapter.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const panels = Array.from(chapter.querySelectorAll<HTMLElement>("[data-panel]"));
    const prev = chapter.querySelector<HTMLButtonElement>("[data-prev]");
    const next = chapter.querySelector<HTMLButtonElement>("[data-next]");
    if (!track || !tabs.length || !panels.length) return;

    let active = 0;
    const setActive = (index: number) => {
      active = Math.max(0, Math.min(panels.length - 1, index));
      tabs.forEach((t, i) => {
        t.setAttribute("aria-selected", String(i === active));
        t.tabIndex = i === active ? 0 : -1;
      });
      panels.forEach((p, i) => p.classList.toggle("is-active", i === active));
      if (prev) prev.disabled = active === 0;
      if (next) next.disabled = active === panels.length - 1;
    };

    const scrollTo = (index: number) => {
      const panel = panels[Math.max(0, Math.min(panels.length - 1, index))];
      const left = panel.offsetLeft - track.offsetLeft;
      track.scrollTo({ left, behavior: "smooth" });
    };

    tabs.forEach((tab, i) => tab.addEventListener("click", () => scrollTo(i)));
    prev?.addEventListener("click", () => scrollTo(active - 1));
    next?.addEventListener("click", () => scrollTo(active + 1));

    chapter.querySelector("[role=tablist]")?.addEventListener("keydown", (event) => {
      const e = event as KeyboardEvent;
      if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
        e.preventDefault();
        const target = e.key === "ArrowRight" ? active + 1 : active - 1;
        scrollTo(target);
        tabs[Math.max(0, Math.min(tabs.length - 1, target))]?.focus();
      }
    });
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") scrollTo(active + 1);
      if (event.key === "ArrowLeft") scrollTo(active - 1);
    });

    // Which panel is closest to the track's left edge?
    let raf = 0;
    track.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const origin = track.scrollLeft + track.clientWidth * 0.25;
          let best = 0;
          let bestDist = Infinity;
          panels.forEach((p, i) => {
            const dist = Math.abs(p.offsetLeft - track.offsetLeft - track.scrollLeft);
            if (dist < bestDist) {
              bestDist = dist;
              best = i;
            }
          });
          void origin;
          if (best !== active) setActive(best);
        });
      },
      { passive: true },
    );
    setActive(0);
  });

  // ── Deep links like /details/#agents keep working; tabs inside a chapter
  //    can be targeted with #agents/island.
  const hash = window.location.hash.slice(1);
  if (hash.includes("/")) {
    const [chapterId, panelId] = hash.split("/");
    const chapter = document.getElementById(chapterId);
    const panel = chapter?.querySelector<HTMLElement>(`[data-panel="${panelId}"]`);
    const track = chapter?.querySelector<HTMLElement>("[data-track]");
    if (chapter && panel && track) {
      chapter.scrollIntoView();
      track.scrollLeft = panel.offsetLeft - track.offsetLeft;
    }
  }

  // ── Lightbox ──
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const lightboxClose = document.getElementById("lightbox-close");
  let lightboxOrigin: Element | null = null;
  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.remove("open");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    window.setTimeout(() => {
      if (!lightbox.classList.contains("open")) lightbox.hidden = true;
    }, 180);
    if (lightboxOrigin instanceof HTMLElement) lightboxOrigin.focus();
  };
  document.querySelectorAll<HTMLImageElement>("img[data-lightbox]").forEach((img) => {
    img.tabIndex = 0;
    img.setAttribute("role", "button");
    const open = () => {
      if (!lightbox || !lightboxImg) return;
      lightboxOrigin = img;
      lightboxImg.src = img.currentSrc || img.src;
      lightboxImg.alt = img.alt;
      lightbox.hidden = false;
      lightbox.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => lightbox.classList.add("open"));
      document.body.style.overflow = "hidden";
      lightboxClose?.focus();
    };
    img.addEventListener("click", open);
    img.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        open();
      }
    });
  });
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox || e.target === lightboxImg) closeLightbox();
  });
  lightboxClose?.addEventListener("click", closeLightbox);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
  });

  // ── Brew copy ──
  const brewBtn = document.getElementById("brew-copy") as HTMLButtonElement | null;
  const brewCmd = document.getElementById("brew-command")?.textContent?.trim();
  brewBtn?.addEventListener("click", async () => {
    if (!brewCmd) return;
    try {
      await navigator.clipboard.writeText(brewCmd);
      brewBtn.textContent = "Copied";
      brewBtn.classList.add("copied");
    } catch {
      brewBtn.textContent = "Copy failed";
    }
    window.setTimeout(() => {
      brewBtn.textContent = "Copy";
      brewBtn.classList.remove("copied");
    }, 1200);
  });
</script>

