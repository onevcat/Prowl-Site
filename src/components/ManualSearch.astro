---
// Command-palette style search over the synced manual. The index is built at
// build time by /manual/search.json and fetched lazily on first open.
---

<div class="msearch" id="msearch" hidden aria-hidden="true">
  <div class="msearch-backdrop" data-msearch-close></div>
  <div class="msearch-panel" role="dialog" aria-modal="true" aria-label="Search the manual">
    <label class="msearch-field">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" width="18" height="18" aria-hidden="true">
        <circle cx="9" cy="9" r="6" />
        <path d="M13.5 13.5L17 17" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        id="msearch-input"
        placeholder="Search the manual — features, shortcuts, CLI commands…"
        autocomplete="off"
        spellcheck="false"
        aria-controls="msearch-results"
      />
      <kbd>esc</kbd>
    </label>
    <ul class="msearch-results" id="msearch-results" role="listbox"></ul>
    <p class="msearch-hint" id="msearch-hint">Type to search across every page. <kbd>↑</kbd><kbd>↓</kbd> to move, <kbd>↩</kbd> to open.</p>
  </div>
</div>

<script>
  import { escapeHtml, highlight } from "../lib/manual-search";

  type Heading = { depth: number; slug: string; text: string };
  type Doc = {
    href: string;
    title: string;
    group: string;
    lead: string;
    keywords: string[];
    headings: Heading[];
    text: string;
  };
  type Hit = { doc: Doc; score: number; hash: string; label: string; snippet: string };

  const root = document.getElementById("msearch");
  const input = document.getElementById("msearch-input") as HTMLInputElement | null;
  const list = document.getElementById("msearch-results");
  const hint = document.getElementById("msearch-hint");
  if (root && input && list && hint) {
    let index: Doc[] | null = null;
    let loading: Promise<Doc[]> | null = null;
    let hits: Hit[] = [];
    let selected = 0;
    let lastFocus: Element | null = null;
    let openFrame = 0;

    function load(): Promise<Doc[]> {
      if (index) return Promise.resolve(index);
      if (!loading) {
        loading = fetch("/manual/search.json")
          .then((r) => r.json())
          .then((data: Doc[]) => (index = data));
      }
      return loading;
    }

    function open() {
      if (root!.getAttribute("aria-hidden") === "false") return;
      lastFocus = document.activeElement;
      root!.hidden = false;
      root!.setAttribute("aria-hidden", "false");
      openFrame = requestAnimationFrame(() => root!.classList.add("open"));
      input!.focus();
      input!.select();
      void load().then(() => search(input!.value));
    }

    function close() {
      cancelAnimationFrame(openFrame);
      root!.classList.remove("open");
      root!.setAttribute("aria-hidden", "true");
      window.setTimeout(() => {
        if (root!.getAttribute("aria-hidden") === "true") root!.hidden = true;
      }, 160);
      if (lastFocus instanceof HTMLElement) lastFocus.focus({ preventScroll: true });
    }

    function snippetAround(text: string, term: string): string {
      const lower = text.toLowerCase();
      const at = lower.indexOf(term);
      if (at === -1) return text.slice(0, 140);
      const start = Math.max(0, at - 60);
      const end = Math.min(text.length, at + term.length + 80);
      return (start > 0 ? "…" : "") + text.slice(start, end) + (end < text.length ? "…" : "");
    }

    function search(query: string) {
      const q = query.trim().toLowerCase();
      const terms = q.split(/\s+/).filter(Boolean);
      hits = [];
      if (!index) return render(terms);
      if (!terms.length) {
        hint!.hidden = false;
        return render(terms);
      }
      hint!.hidden = true;
      for (const doc of index) {
        const title = doc.title.toLowerCase();
        const lead = doc.lead.toLowerCase();
        const keywords = doc.keywords.map((k) => k.toLowerCase());
        const text = doc.text.toLowerCase();
        let score = 0;
        let allMatch = true;
        for (const term of terms) {
          let s = 0;
          if (title.includes(term)) s += title === term ? 60 : 30;
          if (keywords.some((k) => k === term)) s += 24;
          else if (keywords.some((k) => k.includes(term))) s += 14;
          if (lead.includes(term)) s += 8;
          if (text.includes(term)) s += 3;
          if (s === 0) allMatch = false;
          score += s;
        }
        if (!allMatch) continue;
        hits.push({ doc, score, hash: "", label: doc.title, snippet: snippetAround(doc.lead || doc.text, terms[0]) });

        // Section hits: headings that match every term get their own row.
        for (const h of doc.headings) {
          const ht = h.text.toLowerCase();
          if (terms.every((t) => ht.includes(t))) {
            hits.push({ doc, score: score + 18, hash: "#" + h.slug, label: h.text, snippet: doc.title });
          }
        }
      }
      hits.sort((a, b) => b.score - a.score);
      hits = hits.slice(0, 12);
      selected = 0;
      render(terms);
    }

    function render(terms: string[]) {
      if (!index && terms.length) {
        list!.innerHTML = '<li class="msearch-empty">Loading index…</li>';
        return;
      }
      if (!hits.length) {
        list!.innerHTML = terms.length ? '<li class="msearch-empty">No matches. Try a feature name, a key like ⌘⌥↩, or a CLI verb like <code>send</code>.</li>' : "";
        return;
      }
      list!.innerHTML = hits
        .map(
          (hit, i) => `
          <li role="option" aria-selected="${i === selected}" class="msearch-hit${i === selected ? " selected" : ""}" data-i="${i}">
            <a href="${hit.doc.href}${hit.hash}">
              <span class="msearch-hit-main">
                <span class="msearch-hit-title">${highlight(hit.label, terms)}</span>
                <span class="msearch-hit-snippet">${highlight(hit.snippet, terms)}</span>
              </span>
              <span class="msearch-hit-group">${escapeHtml(hit.hash ? "section" : hit.doc.group)}</span>
            </a>
          </li>`,
        )
        .join("");
    }

    function move(delta: number) {
      if (!hits.length) return;
      selected = (selected + delta + hits.length) % hits.length;
      list!.querySelectorAll<HTMLElement>(".msearch-hit").forEach((el, i) => {
        el.classList.toggle("selected", i === selected);
        el.setAttribute("aria-selected", String(i === selected));
        if (i === selected) el.scrollIntoView({ block: "nearest" });
      });
    }

    input.addEventListener("input", () => search(input.value));
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        move(1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        move(-1);
      } else if (event.key === "Enter") {
        event.preventDefault();
        list!.querySelector<HTMLAnchorElement>(".msearch-hit.selected a")?.click();
      }
    });
    list.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (!(event.target instanceof Element) || !event.target.closest("a")) return;
      // A same-document link does not reload the page; dismiss both overlays first.
      close();
      document.dispatchEvent(new Event("manual-search-navigate"));
    });
    list.addEventListener("mousemove", (event) => {
      const li = (event.target as HTMLElement).closest<HTMLElement>(".msearch-hit");
      if (li && Number(li.dataset.i) !== selected) {
        selected = Number(li.dataset.i);
        move(0);
      }
    });
    root.querySelectorAll("[data-msearch-close]").forEach((el) => el.addEventListener("click", close));
    document.querySelectorAll("[data-msearch-open]").forEach((el) => el.addEventListener("click", open));
    document.addEventListener("keydown", (event) => {
      const isOpen = root!.getAttribute("aria-hidden") === "false";
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        isOpen ? close() : open();
      } else if (event.key === "/" && !isOpen && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement)) {
        event.preventDefault();
        open();
      } else if (event.key === "Escape" && isOpen) {
        close();
      }
    });
  }
</script>

<style is:global>
  .msearch {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 1rem 1rem;
    opacity: 0;
    transition: opacity 0.16s ease;
  }

  .msearch[hidden] {
    display: none;
  }

  .msearch.open {
    opacity: 1;
  }

  .msearch-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 10, 20, 0.7);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .msearch-panel {
    position: relative;
    width: min(680px, 100%);
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    background: var(--bg-deep);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.03);
    overflow: hidden;
    transform: translateY(-8px) scale(0.985);
    transition: transform 0.16s ease;
  }

  .msearch.open .msearch-panel {
    transform: none;
  }

  .msearch-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line-soft);
    color: var(--text-muted);
  }

  .msearch-field input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    font: inherit;
    font-size: 1rem;
    color: var(--text-primary);
    caret-color: var(--accent);
  }

  .msearch-field input::placeholder {
    color: var(--text-muted);
  }

  .msearch-field input::-webkit-search-cancel-button {
    display: none;
  }

  .msearch-field kbd,
  .msearch-hint kbd {
    font-size: 0.65rem;
    color: var(--text-muted);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    line-height: 1.3;
  }

  .msearch-results {
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.4rem;
  }

  .msearch-results:empty {
    display: none;
  }

  .msearch-hit a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    color: var(--text-primary);
  }

  .msearch-hit a:hover {
    opacity: 1;
  }

  .msearch-hit.selected a {
    background: rgba(90, 228, 192, 0.09);
  }

  .msearch-hit-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .msearch-hit-title {
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .msearch-hit-snippet {
    font-size: 0.78rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .msearch-hit-group {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
  }

  .msearch-hit mark {
    background: transparent;
    color: var(--accent);
  }

  .msearch-empty {
    padding: 0.9rem 0.75rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .msearch-empty code {
    font-family: var(--font-mono);
    color: var(--accent-dim);
  }

  .msearch-hint {
    padding: 0.6rem 1rem 0.75rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    gap: 0.35rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .msearch-hint[hidden] {
    display: none;
  }
</style>
